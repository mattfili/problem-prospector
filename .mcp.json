{
  "mcpServers": {
    "dialog": {
      "type": "http",
      "url": "https://reddit-research-mcp.fastmcp.app/mcp"
    },
    "trend-pulse": {
      "command": "uvx",
      "args": [
        "--from",
        "trend-pulse[mcp]",
        "--with",
        "mcp<2",
        "trend-pulse-server"
      ]
    },
    "idea-reality": {
      "command": "uvx",
      "args": [
        "idea-reality-mcp"
      ]
    },
    "pain-search": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "${CLAUDE_PLUGIN_ROOT}/scripts/pain_mcp.py"
      ],
      "timeout": 3600000
    }
  }
}
